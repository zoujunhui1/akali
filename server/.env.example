AKALI_DSN="akali:CHANGE_ME@tcp(127.0.0.1:3306)/akali?parseTime=true&charset=utf8mb4&loc=UTC"
AKALI_APP_TOKEN="CHANGE_ME_APP"
AKALI_ADMIN_TOKEN="CHANGE_ME_ADMIN"
AKALI_AUDIO_DIR="/var/lib/akali/audio"
AKALI_ADDR="127.0.0.1:8080"
