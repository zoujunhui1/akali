# Copy to deploy.env (not tracked) and fill in.
DEPLOY_HOST="your.server.ip"
DEPLOY_USER="your-ssh-user"
PUBLIC_HOST="your-public-hostname"
# Optional: ssh key (default ~/.ssh/id_rsa) and machine type (amd64, or arm64 for ARM machines).
# DEPLOY_KEY="$HOME/.ssh/id_rsa"
# DEPLOY_ARCH="amd64"
# Optional: the DeepSeek key for set-ai-key.sh (otherwise the script asks for it).
# DEEPSEEK_KEY=""
